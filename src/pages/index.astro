---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import { projects } from '../content/projects';
import { achievements } from '../content/achievements';
---

<BaseLayout title="Kunal Wagh — Software Developer" description="Kunal Wagh is a first-year CSE (AI & ML) student at MIT Mumbai building software across local search, Linux systems, and TV discovery.">
  <div class="folio-page">
    <SiteHeader home />
    <main id="top">
      <section class="intro page-inner" aria-labelledby="intro-title">
        <div class="intro-topline">
          <p class="eyebrow"><span>SOFTWARE / SYSTEMS</span></p>
          <p>INDEPENDENT DEVELOPER <span>[ 01 ]</span></p>
        </div>
        <h1 id="intro-title">PORTFOLIO<span>.</span></h1>
        <div class="intro-base">
          <p class="intro-name">Kunal Wagh<span>First-year CSE (AI & ML)</span><span>MIT Mumbai · Mumbai</span></p>
          <div>
            <p class="intro-deck">I build useful software across local search, Linux systems, and TV discovery.</p>
            <a class="intro-link" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </section>

      <section id="work" class="work-section page-inner" aria-labelledby="work-title">
        <header class="section-heading">
          <p class="eyebrow"><span>01</span> PROJECTS</p>
          <h2 id="work-title">Selected work</h2>
          <p>Three solo projects, each built around a practical problem.</p>
        </header>
        <div
          class="project-progress"
          role="progressbar"
          aria-label="Project sequence"
          aria-valuemin="1"
          aria-valuemax={projects.length}
          aria-valuenow="1"
          aria-valuetext={`Project 1 of ${projects.length}`}
        >
          <span class="project-progress-current">01</span>
          <span class="project-progress-track" aria-hidden="true"><span class="project-progress-fill" style={`--progress-start: ${1 / projects.length}`}></span></span>
          <span class="project-progress-total">{String(projects.length).padStart(2, '0')}</span>
        </div>
        <div class="projects">
          {projects.map((project, index) => <ProjectShowcase project={project} index={index} />)}
        </div>
      </section>

      <section id="achievements" class="recognition-section page-inner" aria-labelledby="recognition-title">
        <p class="eyebrow"><span>02</span> RECOGNITION</p>
        <div class="recognition-row">
          <p class="recognition-count">{String(achievements.length).padStart(2, '0')}</p>
          <div>
            <h2 id="recognition-title">{achievements.length === 1 ? 'Competition win' : 'Competition wins'}</h2>
            {achievements.map((achievement) => (
              <div class="achievement-detail">
                <p><strong>{achievement.result} · {achievement.competition}</strong></p>
                <p>{achievement.organizer} · Built <a href={achievement.projectUrl} target="_blank" rel="noreferrer">{achievement.project}</a></p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="interests-section page-inner" aria-labelledby="interests-title">
        <header class="section-heading">
          <p class="eyebrow"><span>03</span> CURRENT CURIOSITIES</p>
          <h2 id="interests-title">What I’m exploring</h2>
        </header>
        <ul class="interest-list">
          <li><span>01</span><strong>DevOps and Linux systems</strong><p>How software behaves beneath the interface and the systems that run it.</p></li>
          <li><span>02</span><strong>Local-first search</strong><p>Indexing, ranking, and making results explain themselves.</p></li>
          <li><span>03</span><strong>AI</strong><p>Exploring practical ways to make software more useful.</p></li>
        </ul>
      </section>

      <section id="about" class="about-section page-inner" aria-labelledby="about-title">
        <p class="eyebrow"><span>04</span> ABOUT</p>
        <figure class="about-photo">
          <img src="/images/elliot-miku.png" width="512" height="512" alt="Kunal with a Hatsune Miku figure" loading="lazy" />
          <figcaption>ELLIOT &amp; MIKU</figcaption>
        </figure>
        <div class="about-copy">
          <h2 id="about-title">I like making tricky things feel manageable.</h2>
          <p>I’m a first-year CSE (AI & ML) student at MIT Mumbai. I build software around practical problems: finding a document by its contents, managing Bluetooth devices on Linux, and discovering what’s available to watch in India.</p>
          <p>I care about the decisions behind the feature list: clear boundaries, useful fallbacks, and software that behaves predictably.</p>
        </div>
      </section>

      <section id="contact" class="contact-section page-inner" aria-labelledby="contact-title">
        <p class="eyebrow"><span>05</span> CONTACT</p>
        <div class="contact-row">
          <h2 id="contact-title">Let’s talk about software.</h2>
          <div class="contact-links">
            <div class="email-actions">
              <a class="contact-link" href="mailto:kunalwagh916@gmail.com">
                kunalwagh916@gmail.com <span aria-hidden="true">↗</span>
              </a>
              <button class="copy-email" type="button" data-copy-email="kunalwagh916@gmail.com">
                <span data-copy-label>Copy email</span><span aria-hidden="true">▢</span>
              </button>
              <span class="visually-hidden" data-copy-status role="status" aria-live="polite" aria-atomic="true"></span>
            </div>
            <a class="contact-link" href="https://github.com/Kaiser879" target="_blank" rel="noreferrer">
              GitHub profile <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <dialog class="preview-dialog" aria-labelledby="preview-dialog-title">
      <header class="preview-dialog-header">
        <div>
          <p class="eyebrow"><span>PROJECT PREVIEW</span></p>
          <h2 id="preview-dialog-title">Project</h2>
        </div>
        <form method="dialog">
          <button class="preview-dialog-close" aria-label="Close project preview">Close <span aria-hidden="true">×</span></button>
        </form>
      </header>
      <div class="preview-dialog-content" data-preview-content></div>
    </dialog>

    <footer class="site-footer page-inner">
      <a class="wordmark" href="#top">Kunal Wagh<span>.</span></a>
      <span>© {new Date().getFullYear()} Kunal Wagh</span>
      <a href="#top">Back to top ↑</a>
    </footer>
  </div>
</BaseLayout>

<script>
  import '../scripts/motion';
  import '../scripts/interactions';
</script>
