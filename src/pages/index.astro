---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import { projects } from '../content/projects';
import { competitionWins } from '../content/achievements';
---

<BaseLayout title="Kunal — Software Developer" description="Independent software projects in local search, Linux systems, and TV discovery.">
  <div class="folio-page">
    <SiteHeader />
    <main id="top">
      <section class="intro page-inner" aria-labelledby="intro-title">
        <div class="intro-topline">
          <p class="eyebrow"><span>SOFTWARE / SYSTEMS</span></p>
          <p>INDEPENDENT DEVELOPER <span>[ 01 ]</span></p>
        </div>
        <h1 id="intro-title">PORTFOLIO<span>.</span></h1>
        <div class="intro-base">
          <p class="intro-name">Kunal<span>Independent developer</span></p>
          <div>
            <p class="intro-deck">I build useful software across local search, Linux systems, and TV discovery.</p>
            <a class="intro-link" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </section>

      <section id="work" class="work-section page-inner" aria-labelledby="work-title">
        <header class="section-heading">
          <p class="eyebrow"><span>01</span> PROJECTS</p>
          <h2 id="work-title">Selected work</h2>
          <p>Three independent projects, each built around a practical problem.</p>
        </header>
        <div class="projects">
          {projects.map((project, index) => <ProjectShowcase project={project} index={index} />)}
        </div>
      </section>

      <section id="achievements" class="recognition-section page-inner" aria-labelledby="recognition-title">
        <p class="eyebrow"><span>02</span> RECOGNITION</p>
        <div class="recognition-row">
          <p class="recognition-count">{String(competitionWins).padStart(2, '0')}</p>
          <div>
            <h2 id="recognition-title">Competition wins</h2>
            <p>Three competition wins.</p>
          </div>
        </div>
      </section>

      <section class="interests-section page-inner" aria-labelledby="interests-title">
        <header class="section-heading">
          <p class="eyebrow"><span>03</span> CURRENT CURIOSITIES</p>
          <h2 id="interests-title">What I’m exploring</h2>
        </header>
        <ul class="interest-list">
          <li><span>01</span><strong>Linux and systems software</strong><p>How software behaves beneath the interface.</p></li>
          <li><span>02</span><strong>Local-first search</strong><p>Indexing, ranking, and making results explain themselves.</p></li>
          <li><span>03</span><strong>Useful interfaces</strong><p>Clear interactions built around real constraints.</p></li>
        </ul>
      </section>

      <section id="about" class="about-section page-inner" aria-labelledby="about-title">
        <p class="eyebrow"><span>04</span> ABOUT</p>
        <div class="about-copy">
          <h2 id="about-title">I like making tricky things feel manageable.</h2>
          <p>I’m Kunal, an early-career developer. My projects range from finding a document by its contents to managing Bluetooth devices on Linux and discovering what’s available to watch in India.</p>
          <p>I care about the decisions behind the feature list: clear boundaries, useful fallbacks, and software that behaves predictably.</p>
        </div>
      </section>

      <section id="contact" class="contact-section page-inner" aria-labelledby="contact-title">
        <p class="eyebrow"><span>05</span> CONTACT</p>
        <div class="contact-row">
          <h2 id="contact-title">Let’s talk about software.</h2>
          <a class="contact-link" href="https://github.com/Kaiser879" target="_blank" rel="noreferrer">
            Find me on GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer page-inner">
      <a class="wordmark" href="#top">Kunal<span>.</span></a>
      <span>© {new Date().getFullYear()} Kunal</span>
      <a href="#top">Back to top ↑</a>
    </footer>
  </div>
</BaseLayout>
